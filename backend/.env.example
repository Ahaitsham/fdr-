NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fdr_portal?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Frontend origin(s), comma separated. Production: your Vercel URL
FRONTEND_ORIGIN=http://localhost:5173
# Private document storage folder (use a Railway Volume mount in production)
UPLOAD_DIR=uploads
# Email (optional - if SMTP_HOST is empty, emails are only logged in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AICTE FDR Portal <no-reply@example.com>"
REMINDERS_ENABLED=true
# Used only by `npm run create-admin` / `npm run seed`
ADMIN_NAME=AICTE Officer
ADMIN_EMAIL=officer@aicte-demo.gov.in
ADMIN_PASSWORD=ChangeMe@12345
